# DigiLocker Requester credentials
# Keep real credentials OUT of GitHub.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Must match the redirect URI approved for your DigiLocker application.
DIGILOCKER_REDIRECT_URI=http://localhost:8000/auth/digilocker/callback

# Current Requester OAuth endpoints
DIGILOCKER_AUTH_URL=https://entity.digilocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://entity.digilocker.gov.in/public/oauth2/1/token

# Use true while developing the UI without live DigiLocker credentials.
DIGILOCKER_DEMO_MODE=true
