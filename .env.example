# ==============================================================================
# SEVENTH-DAY ADVENTIST (SDA) MATRIMONY PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development

# Frontend Application (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# Core Backend API (NestJS)
API_PORT=4000
API_PREFIX=api/v1
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_32chars
JWT_REFRESH_EXPIRATION=7d

# Real-time WebSocket Gateway
WS_PORT=4001

# PostgreSQL Database (with pgvector)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sda_matrimony_user
DATABASE_PASSWORD=sda_matrimony_secure_password
DATABASE_NAME=sda_matrimony_db
DATABASE_URL=postgresql://sda_matrimony_user:sda_matrimony_secure_password@localhost:5432/sda_matrimony_db?schema=public

# Redis (Caching, Sessions & Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# AI & Machine Learning Microservice (FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000/api/v1
AI_SERVICE_SECRET=your_internal_service_token

# Object Storage (MinIO / AWS S3 / Cloudflare R2)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sda-matrimony-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Transactional Email (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@sdatrimony.org
SMTP_FROM_NAME="SDA Matrimony Platform"

# Sentry Error Monitoring (Optional in development)
SENTRY_DSN=
